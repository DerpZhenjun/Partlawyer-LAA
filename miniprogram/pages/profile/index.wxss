.profile-card{padding:34rpx;display:flex;align-items:center;gap:22rpx;border-radius:26rpx;color:#fff;background:linear-gradient(135deg,#0b1f3a,#0d615f)}.logo{width:82rpx;height:82rpx;display:grid;place-items:center;border:1rpx solid rgba(255,255,255,.25);border-radius:22rpx;background:rgba(255,255,255,.08);font:700 36rpx serif}.profile-card text{display:block}.profile-card text:first-child{font-size:31rpx;font-weight:700}.profile-card text:last-child{margin-top:7rpx;color:#a8c4cd;font-size:21rpx}.menu{overflow:hidden}.menu view{position:relative;padding:26rpx 68rpx 26rpx 26rpx;border-bottom:1rpx solid #e7ebef}.menu view:last-child{border:0}.menu text{display:block}.menu text:first-child{font-size:26rpx;font-weight:600}.menu text:nth-child(2){margin-top:7rpx;color:#8995a1;font-size:20rpx}.menu text:last-child{position:absolute;right:26rpx;top:38rpx;color:#9ca6b0;font-size:32rpx}.disclaimer{display:block;margin:50rpx 30rpx;color:#98a2ad;text-align:center;font-size:19rpx;line-height:1.7}
