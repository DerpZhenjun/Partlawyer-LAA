.top{display:flex;align-items:center;justify-content:space-between}.title,.desc{display:block}.title{font-size:40rpx;font-weight:800}.desc{margin-top:7rpx;color:#7c8997;font-size:22rpx}.add{width:72rpx;height:72rpx;margin:0;padding:0;line-height:68rpx;border-radius:20rpx;color:#fff;background:#0f766e}.search{height:84rpx;margin-top:26rpx;padding:0 26rpx;display:flex;align-items:center;gap:14rpx;color:#8d98a4}.search input{flex:1;font-size:24rpx}.filters{display:flex;gap:34rpx;padding:24rpx 4rpx;overflow:auto;white-space:nowrap;color:#7b8794;font-size:22rpx}.filters .active{color:#0f766e;font-weight:700}.case{margin-bottom:16rpx;padding:27rpx}.case-head,.case-foot{display:flex;justify-content:space-between;align-items:center}.case-head>text:first-child{font-size:28rpx;font-weight:700}.case-id,.employer{display:block}.case-id{margin:11rpx 0 7rpx;color:#7d8997;font-size:20rpx}.employer{font-size:22rpx}.case-foot{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #e8ecef;color:#7e8996;font-size:20rpx}.deadline{color:#a56c18}.mask{position:fixed;inset:0;z-index:10;display:flex;align-items:flex-end;background:rgba(7,22,42,.55)}.sheet{width:100%;padding:34rpx 30rpx 50rpx;border-radius:32rpx 32rpx 0 0;background:#fff}.sheet-head{display:flex;justify-content:space-between;margin-bottom:25rpx;font-size:34rpx;font-weight:700}.sheet label{display:block;margin-top:20rpx;color:#4e5d6e;font-size:22rpx}.sheet input{height:78rpx;margin-top:8rpx;padding:0 20rpx;border:1rpx solid #dfe5ea;border-radius:14rpx;font-size:24rpx}.sheet button{margin-top:30rpx}
