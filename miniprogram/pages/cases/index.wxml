<view class="page"><view class="top"><view><text class="title">案件中心</text><text class="desc">集中管理案情、证据与关键时限</text></view><button class="add" bindtap="openCreate">＋</button></view><view class="search card">⌕<input bindinput="onSearch" placeholder="搜索案件号、当事人或单位" /></view><view class="filters"><text class="active">全部</text><text>案情梳理</text><text>材料准备</text><text>待提交</text><text>审理中</text></view><view class="case-list"><view wx:for="{{cases}}" wx:key="id" class="card case"><view class="case-head"><text>{{item.title}}</text><text class="pill">{{item.stage}}</text></view><text class="case-id">{{item.id}} · {{item.client}}</text><text class="employer">{{item.employer || '用人单位信息待补充'}}</text><view class="case-foot"><text>材料完整度 {{item.progress}}%</text><text class="deadline">{{item.deadline}}</text></view></view></view></view>
<view wx:if="{{showCreate}}" class="mask" bindtap="closeCreate"><view class="sheet" catchtap="noop"><view class="sheet-head"><text>建立案件档案</text><text bindtap="closeCreate">×</text></view><label>争议类型<input data-key="title" bindinput="field" placeholder="例如：违法解除劳动合同" /></label><label>申请人<input data-key="client" bindinput="field" placeholder="建议使用脱敏姓名" /></label><label>用人单位<input data-key="employer" bindinput="field" placeholder="单位完整名称" /></label><button class="button-primary" bindtap="createCase">创建案件</button></view></view>
