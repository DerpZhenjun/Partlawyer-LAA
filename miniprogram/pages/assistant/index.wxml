<view class="assistant-page"><view class="notice">ⓘ 回答仅供辅助梳理，重要结论请结合原始材料核验。</view><scroll-view class="stream" scroll-y scroll-into-view="bottom"><view wx:for="{{messages}}" wx:key="index" class="message {{item.role}}"><view wx:if="{{item.role==='ai'}}" class="avatar">法</view><view class="bubble">{{item.content}}</view></view><view wx:if="{{loading}}" class="message ai"><view class="avatar">法</view><view class="bubble">正在分析案情…</view></view><view id="bottom"></view></scroll-view><view class="prompts"><text wx:for="{{prompts}}" wx:key="*this" data-text="{{item}}" bindtap="usePrompt">{{item}}</text></view><view class="composer"><textarea value="{{input}}" bindinput="onInput" auto-height maxlength="2000" placeholder="描述案情，建议将姓名等信息脱敏" /><button bindtap="send" disabled="{{loading}}">↑</button></view></view>
