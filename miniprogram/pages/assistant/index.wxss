.assistant-page{height:calc(100vh - 0px);display:flex;flex-direction:column;background:#f3f6f9}.notice{padding:18rpx 26rpx;color:#806d4d;background:#fff8e8;font-size:20rpx}.stream{flex:1;height:0;padding:26rpx;box-sizing:border-box}.message{display:flex;gap:14rpx;margin-bottom:24rpx}.message.user{justify-content:flex-end}.avatar{flex:0 0 58rpx;height:58rpx;display:grid;place-items:center;border-radius:16rpx;color:#fff;background:#0f766e;font-family:serif}.bubble{max-width:78%;padding:20rpx 22rpx;border:1rpx solid #e1e6eb;border-radius:6rpx 22rpx 22rpx;background:#fff;color:#34445a;font-size:25rpx;line-height:1.65}.user .bubble{border-color:#0f766e;border-radius:22rpx 6rpx 22rpx 22rpx;color:#fff;background:#0f766e}.prompts{display:flex;gap:12rpx;padding:12rpx 24rpx;overflow:auto;white-space:nowrap}.prompts text{padding:12rpx 16rpx;border:1rpx solid #d9e2e4;border-radius:14rpx;color:#4d676c;background:#fff;font-size:20rpx}.composer{display:flex;align-items:flex-end;gap:14rpx;padding:20rpx 24rpx 36rpx;border-top:1rpx solid #e1e6eb;background:#fff}.composer textarea{flex:1;min-height:66rpx;max-height:180rpx;padding:15rpx 18rpx;border-radius:18rpx;background:#f3f6f8;font-size:24rpx}.composer button{width:68rpx;height:68rpx;margin:0;padding:0;line-height:64rpx;border-radius:20rpx;color:#fff;background:#0f766e}
